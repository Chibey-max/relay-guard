{
  "name": "relay-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Speak your money. SERV Reasoning decides if it should move. Relay Guard returns an ALLOW / REVIEW / BLOCK verdict with checkable reasons between a plain-English payment intent and the wallet signature, and refuses to execute without a signed receipt.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "agent:address": "node scripts/get-agent-address.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@magic-ext/oauth2": "^4.0.0",
    "@magic-sdk/provider": "^33.7.1",
    "@particle-network/universal-account-sdk": "^1.0.0",
    "@zerodev/ecdsa-validator": "^5.4.0",
    "@zerodev/sdk": "^5.4.0",
    "ethers": "^6.13.0",
    "framer-motion": "^12.42.2",
    "openai": "^4.77.0",
    "magic-sdk": "^33.7.1",
    "next": "14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "^8.4.39",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.0"
  }
}
